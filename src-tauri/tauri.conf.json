{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Purge",
  "version": "0.2.0",
  "identifier": "dev.purge.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Purge",
        "width": 1180,
        "height": 760,
        "theme": "Dark",
        "backgroundColor": "#1a1d21",
        "resizable": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost ws://localhost:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1NjVDRjA5QzM3QjA1NDUKUldSRkJYdkRDYzlsbFg1YnN2RUJKdlhTQWFiMVRWYTJSSCtIWUlwV2JZZGRzK3F2T1FDZUZBVHMK",
      "endpoints": [
        "https://github.com/bernaljeanp/purge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
